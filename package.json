{
  "name": "@cleverc2200/dsh-personal-memory",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "通过 GEA Host 召回当前用户偏好的独立只读 DSH 插件。",
  "main": "./index.mjs",
  "types": "./index.d.mts",
  "exports": {
    ".": {
      "types": "./index.d.mts",
      "default": "./index.mjs"
    },
    "./package.json": "./package.json",
    "./cordis.patch.yml": "./cordis.patch.yml"
  },
  "files": [
    "index.mjs",
    "index.d.mts",
    "cordis.patch.yml",
    "vendor",
    "README.md",
    "NOTICE.md"
  ],
  "scripts": {
    "test": "node --test tests/*.test.mjs",
    "check:package": "npm pack --ignore-scripts --dry-run"
  },
  "peerDependencies": {
    "@cleverc2200/gea-dsh-prototype": "0.0.183",
    "@deepseek-ai/cordis": "4.0.4",
    "@deepseek-ai/dsh-agent": "0.2.0-rc.2",
    "@deepseek-ai/dsh-llm": "0.2.0-rc.2",
    "@deepseek-ai/schemastery": "3.18.4"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  },
  "engines": {
    "node": ">=22.15.0"
  },
  "license": "UNLICENSED",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/CleverC2200/dsh-personal-memory.git"
  },
  "homepage": "https://github.com/CleverC2200/dsh-personal-memory#readme",
  "bugs": {
    "url": "https://github.com/CleverC2200/dsh-personal-memory/issues"
  },
  "peerDependenciesMeta": {
    "@cleverc2200/gea-dsh-prototype": {
      "optional": true
    }
  },
  "devDependencies": {
    "@deepseek-ai/cordis": "4.0.4",
    "@deepseek-ai/dsh-agent": "0.2.0-rc.2",
    "@deepseek-ai/dsh-llm": "0.2.0-rc.2",
    "@deepseek-ai/schemastery": "3.18.4"
  }
}
